<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- SplashScreen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mono_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.MyPlayStore</item>
    </style>

    <!-- Base application theme. -->
    <style name="Base.Theme.MyPlayStore" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mono_primary</item>
        <item name="colorPrimaryDark">@color/mono_primary_dark</item>
        <item name="colorSecondary">@color/mono_accent</item>
        <item name="colorSecondaryContainer">#E4E4E7</item>
        <item name="colorOnSecondaryContainer">#09090B</item>
        <item name="android:windowBackground">@color/mono_background</item>
        <item name="android:statusBarColor">@color/mono_primary_dark</item>
    </style>

    <style name="Theme.MyPlayStore" parent="Base.Theme.MyPlayStore" />
</resources>
